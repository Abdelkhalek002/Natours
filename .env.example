# Environment
NODE_ENV=development
PORT=8000

# Database Configuration (Choose either Cloud Atlas or Local)
# Option 1: MongoDB Atlas (Recommended for cloud/reviewers)
# DATABASE=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.xxxx.mongodb.net/natours?retryWrites=true&w=majority
# DATABASE_PASSWORD=your_database_password

# Option 2: Local MongoDB
DATABASE_LOCAL=mongodb://127.0.0.1:27017/natours

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-must-be-at-least-32-characters-long
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_placeholder

# Email Configuration (Nodemailer / Mailtrap for Development)
EMAIL_FROM=Natours Admin <admin@natours.io>
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=your_mailtrap_username
EMAIL_PASSWORD=your_mailtrap_password

# Optional: Production Email (SendGrid)
SENDGRID_USERNAME=apikey
SENDGRID_PASSWORD=your_sendgrid_api_key
