header.site-header
  .site-header__inner.container
    a.site-brand(href='/')
      img.site-brand__logo(src='/img/logo-green.png', alt='Natours logo')
      //- span Natours

    nav.site-nav(aria-label='Primary navigation')
      a.site-nav__link(href='/') All tours

    .site-header__actions
      if user
        a.user-pill(href='/me')
          img.user-pill__img(
            src=`/img/users/${user.photo}`,
            alt=`Photo of ${user.name}`
          )
          span= user.name.split(' ')[0]
        button.btn.btn--ghost.btn--sm.nav__el--logout(type='button') Log out
      else
        a.btn.btn--ghost.btn--sm(href='/login') Log in
        a.btn.btn--primary.btn--sm(href='/signup') Sign up
