extends base
include _accountShell

block content
  - const reviewList = Array.isArray(reviews) ? reviews : [];
  - const pendingList = Array.isArray(pendingTours) ? pendingTours : [];
  - const total = totalReviews != null ? totalReviews : reviewList.length;
  - const avg = avgRating != null ? Number(avgRating).toFixed(1) : '0.0';

  +accountShell('reviews', user, 'My Reviews')
    .settings-card__header
      h1.type-headline-md.text-heading My reviews
      p.type-body-sm.text-muted Share feedback from your expeditions and help fellow travelers choose their next route.

    .stats-row
      .stat-card
        span.type-label-caps.text-muted Total Published
        span.type-headline-lg.text-heading= total
      .stat-card
        span.type-label-caps.text-muted Average Rating
        span.type-headline-lg.text-primary= `${avg} / 5.0`
      .stat-card
        span.type-label-caps.text-muted Pending Reviews
        span.type-headline-lg.text-heading= pendingList.length

    if pendingList.length > 0
      .pending-alert
        div
          h2.type-headline-sm.text-heading= `${pendingList.length} ${pendingList.length === 1 ? 'expedition' : 'expeditions'} awaiting your review`
          p.type-body-sm.text-muted Share your trail notes and rating for tours you have already booked.
        button#btn-open-create-review.btn.btn--primary.btn--sm(
          type='button',
          data-modal-open='modal-review-form'
        )
          span.material-symbols-outlined edit_note
          span Write Review

    if reviewList.length > 0
      .grid
        each rev in reviewList
          - const revId = rev.id || rev._id;
          - const tour = rev.tour || {};
          - const tourId = tour.id || tour._id || '';
          - const createdDate = rev.createdAt ? new Date(rev.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
          article.card
            .card__body
              .booking-card__top
                div
                  if tour.slug
                    a.type-headline-sm.text-heading(href=`/tour/${tour.slug}`)= tour.name || 'Expedition'
                  else
                    h3.type-headline-sm.text-heading= tour.name || 'Expedition'
                  p.type-caption.text-muted
                    if tour.startLocation && tour.startLocation.description
                      | #{tour.startLocation.description}
                      if createdDate
                        |  · 
                    | #{createdDate}
                .review-card__stars(aria-label=`Rated ${rev.rating} out of 5`)
                  each star in [1, 2, 3, 4, 5]
                    span.material-symbols-outlined(
                      class=star <= rev.rating ? 'icon--filled text-primary' : 'text-muted'
                    ) star

              p.type-body-md(style='margin-block: 1rem;')= rev.review

              .booking-card__footer
                span.type-label-numeric.text-muted= `${rev.rating}.0 / 5.0`
                .table-actions
                  button.btn.btn--secondary.btn--sm.btn-edit-review(
                    type='button',
                    data-review-id=revId,
                    data-tour-id=tourId,
                    data-tour-name=tour.name || 'Expedition',
                    data-rating=rev.rating,
                    data-review=rev.review
                  ) Edit
                  button.btn.btn--danger.btn--sm.btn-delete-review(
                    type='button',
                    data-review-id=revId,
                    data-tour-name=tour.name || 'Expedition'
                  ) Delete
    else
      .empty-state
        span.material-symbols-outlined.text-muted rate_review
        h2.type-headline-sm.text-heading No reviews published yet
        p.type-body-sm.text-muted Once you book an expedition, you can publish a verified traveler review here.
        if pendingList.length === 0
          a.btn.btn--primary.btn--sm(href='/') Explore Tours

    #modal-review-form.modal-backdrop(
      hidden,
      aria-hidden='true',
      role='dialog',
      aria-modal='true',
      aria-labelledby='modal-review-title'
    )
      .modal-panel
        .modal__header
          h2#modal-review-title.type-headline-sm.text-heading Write Review
          button.modal__close(
            type='button',
            data-modal-close='modal-review-form',
            aria-label='Close review modal'
          )
            span.material-symbols-outlined close

        form#form-review
          input#review-id(type='hidden', value='')

          #review-tour-group.form-group
            label.form-label(for='review-tour-select') Expedition
            select#review-tour-select.select(name='tour')
              each pt in pendingList
                option(value=pt.id || pt._id)= pt.name

          #review-tour-readonly.form-group(hidden)
            span.form-label Expedition
            p#review-tour-name.type-body-md.text-heading

          .form-group
            span.form-label Rating
            input#review-rating(type='hidden', name='rating', value='5')
            #review-star-picker.star-picker
              each star in [1, 2, 3, 4, 5]
                button.star-picker__btn.is-active(
                  type='button',
                  data-rating=star,
                  aria-label=`Rate ${star} stars`
                )
                  span.material-symbols-outlined.icon--filled star

          .form-group
            label.form-label(for='review-text') Your Review
            textarea#review-text.textarea(
              name='review',
              required,
              placeholder='Share your trail highlights, guides, and pacing...'
            )

          .modal__footer
            button.btn.btn--secondary.btn--sm(
              type='button',
              data-modal-close='modal-review-form'
            ) Cancel
            button#btn-submit-review.btn.btn--primary.btn--sm(type='submit') Publish Review

    #modal-confirm-delete.modal-backdrop(
      hidden,
      aria-hidden='true',
      role='dialog',
      aria-modal='true',
      aria-labelledby='modal-delete-title'
    )
      .modal-panel
        .modal__header
          h2#modal-delete-title.type-headline-sm.text-heading Delete Review
          button.modal__close(
            type='button',
            data-modal-close='modal-confirm-delete',
            aria-label='Close confirmation modal'
          )
            span.material-symbols-outlined close

        p#delete-review-message.type-body-md Are you sure you want to delete this review? This action cannot be undone.

        .modal__footer
          button.btn.btn--secondary.btn--sm(
            type='button',
            data-modal-close='modal-confirm-delete'
          ) Cancel
          button#btn-confirm-delete-review.btn.btn--danger.btn--sm(type='button') Delete Review
