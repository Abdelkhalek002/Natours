mixin reviewCard(review)
  article.review-card
    .review-card__user
      img.review-card__avatar(
        src=`/img/users/${review.user && review.user.photo ? review.user.photo : 'default.jpg'}`,
        alt=review.user ? review.user.name : 'Traveler'
      )
      div
        h3.type-headline-sm= review.user ? review.user.name : 'Traveler'
        if review.createdAt
          p.type-caption.text-muted= new Date(review.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
    p.type-body-md= review.review
    .review-card__stars(aria-label=`Rated ${review.rating} out of 5`)
      each star in [1, 2, 3, 4, 5]
        span.material-symbols-outlined(
          class=review.rating >= star ? 'icon--filled' : 'text-muted',
          aria-hidden='true'
        ) star
