doctype html
html(lang='en')
  head
    block head
      meta(charset='UTF-8')
      meta(name='viewport', content='width=device-width, initial-scale=1.0')
      link(rel='preconnect', href='https://fonts.googleapis.com')
      link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
      link(
        rel='stylesheet',
        href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap'
      )
      link(
        rel='stylesheet',
        href='https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200'
      )
      link(rel='stylesheet', href='/css/style.css')
      link(rel='shortcut icon', href='/img/favicon.png', type='image/png')
      title Natours | #{title}

  body
    #toast-region.toast-region(aria-live='polite', aria-atomic='true')
    include _header
    block content
      h1 placeholder heading
    include _footer

    script(src='/js/bundle.js', defer)
